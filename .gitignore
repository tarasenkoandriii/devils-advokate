# Обнаружено при аудите: .gitignore отсутствовал во всём монорепо —
# реальный риск, что .env с настоящими ключами (OPENAI_API_KEY,
# TELEGRAM_BOT_TOKEN и т.д.) попал бы в git. Один файл на корень
# монорепо, не по одному на каждый apps/* — npm workspaces имеют общий
# node_modules в корне, паттерны ниже покрывают все apps/* через **/.

# Папка, в которую приложение Claude складывает отданные в чат файлы.
# Правило было написано как `Claude/outputs/` и не работало: это путь
# «папка Claude → папка outputs», а настоящая папка называется
# «Claude outputs», через пробел. Проверено `git check-ignore`.
Claude outputs/

# Зависимости
node_modules/
**/node_modules/

# Секреты — .env.example коммитится, реальные .env — никогда
.env
.env.local
.env.*.local
!.env.example

# Next.js
.next/
**/.next/
out/
**/out/
# Создаётся самим `next dev` при первом запуске (в том числе внутри
# докер-контейнера, поверх примонтированной папки) — артефакт, не исходник.
next-env.d.ts
**/next-env.d.ts

# NestJS / TypeScript
dist/
**/dist/
*.tsbuildinfo

# Prisma
apps/api/prisma/migrations/dev.db*

# Логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ОС/редакторы
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Vercel
.vercel

# Тестовое покрытие
coverage/

# Docker dev-стенд (DOCKER.md): реальные значения — локальные, шаблон
# .env.docker.example коммитится.
.env.docker
