# Devil's Advocate — apps/admin окружение

# Базовый URL backend API (apps/api) — БЕЗ завершающего слэша.
# Все запросы (аутентификация, модерация, промпты, телеметрия) идут
# на этот домен с credentials: 'include' — cookie AdminSession
# устанавливается ЭТИМ доменом (см. admin-auth.controller.ts), не
# доменом самой админки. В проде должен совпадать с CORS_ORIGIN на
# стороне apps/api, иначе браузер отклонит cross-origin cookie.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Username бота — используется Telegram Login Widget-скриптом для
# определения, какой бот выдаёт кнопку "Войти через Telegram" (БЕЗ
# символа @). Тот же бот, чей TELEGRAM_BOT_TOKEN настроен на backend —
# два значения должны указывать на одного бота, иначе HMAC-проверка
# payload на backend всегда будет проваливаться.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# ── Docker dev-запуск (DOCKER.md) ──
# Показывает на /login кнопку «Войти как dev-…» вместо Telegram Login
# Widget. Виджет физически не работает на http://localhost (Telegram
# привязывает его к домену, заданному боту через /setdomain, и localhost
# туда не принимается) — без этой кнопки админка в локальном стенде
# недоступна в принципе.
# ЭТО ТОЛЬКО ПРО ВИДИМОСТЬ КНОПКИ: реальное разрешение выдаёт бэкенд
# (POST /admin/auth/dev-login отвечает 404, если на стороне apps/api не
# выставлены ОДНОВРЕМЕННО ALLOW_DEV_AUTH=true и NODE_ENV!=production).
NEXT_PUBLIC_ALLOW_DEV_AUTH="false"

# Условный id для дев-входа. Должен совпадать с NEXT_PUBLIC_DEV_USER_ID
# в apps/tma — тогда админка и TMA работают под ОДНИМ пользователем
# (telegramId "dev-<это значение>"), и сценарий «создал в TMA → увидел
# в модерации» проверяется по-настоящему.
NEXT_PUBLIC_DEV_USER_ID="123"
