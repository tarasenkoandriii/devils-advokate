# apps/landing — переменные окружения. Все NEXT_PUBLIC_* — подставляются
# в статическую сборку (build time), не читаются динамически в проде.

# Полный URL продакшн-домена — нужен для sitemap.xml/robots.txt
# (абсолютные ссылки), без протокола/слэша на конце.
NEXT_PUBLIC_SITE_URL="https://devils-advocate.example.com"

# Ссылка на бота/TMA — основной CTA лендинга ("Открыть в Telegram").
# Формат: https://t.me/<bot_username>/<app_short_name>
NEXT_PUBLIC_TELEGRAM_BOT_URL="https://t.me/your_bot_username/app"

# Юридические реквизиты для футера (ФОП/ЄДРПОУ — паттерн, уже
# используемый в других проектах). Опционально — если не задано, футер
# просто не показывает эту строку, не падает.
NEXT_PUBLIC_LEGAL_ENTITY=""

# Telegram-юзернейм для ссылки "Контакты" в футере, без @.
NEXT_PUBLIC_CONTACT_TELEGRAM=""
