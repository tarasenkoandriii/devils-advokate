# apps/tma — переменные окружения

# URL бэкенда (apps/api). В проде — реальный домен API.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# DEV-режим (см. lib/telegram.ts): используется только когда
# window.Telegram недоступен (обычная разработка в браузере вне
# Telegram). Должно совпадать с тем, что бэкенд ожидает при
# ALLOW_DEV_AUTH=true (apps/api/.env, X-Dev-User-Id -> telegramId
# "dev-<это значение>"). НЕ устанавливать в production-сборке.
NEXT_PUBLIC_DEV_USER_ID="123"

# Пункт [one-build-two-products] 2026-10-01 — КАКИЕ ДОМЕНЫ ПОКАЗЫВАЕТ ЭТА
# СБОРКА. Список идентификаторов через запятую; пусто или переменной нет
# ⇒ ВСЕ домены, то есть поведение существующих проектов ровно прежнее и
# выставлять здесь ничего не нужно.
#
# Заведено ради вопроса «можно ли запустить модуль найма отдельным
# продуктом на своём домене»: связность job-экранов с остальным TMA
# оказалась почти нулевой, и не хватало только способа СОБРАТЬ часть.
# Без выключателя это была бы вторая ветка дерева, которую пришлось бы
# держать в синхроне руками, — то есть способ развести два продукта
# молча.
#
#   NEXT_PUBLIC_TMA_DOMAINS="job-search,interview-pool,employer-hiring"
#
# Известные значения: dtp, family-law, health, investment, major-purchase,
# interview-pool, job-search, employer-hiring. Неизвестное имя в списке
# ОСТАНАВЛИВАЕТ сборку — опечатка иначе дала бы продукт без половины
# экранов и ни слова об этом.
#
# ЧЕГО ЭТА ПЕРЕМЕННАЯ НЕ ДЕЛАЕТ, и это важнее того, что делает: она НЕ
# защита. Сервер отдаёт все маршруты всем; выключенный домен просто не
# показан в этой сборке, а права проверяет только сервер. И она не делит
# пользователей и проекты — `User` и `Project` общие, один человек это
# один аккаунт в обоих продуктах.
NEXT_PUBLIC_TMA_DOMAINS=""
