# Чекпоинт 1, пункт 11 — переменные окружения для TMA auth

# Локально — обычное прямое соединение к docker-compose Postgres (см.
# docker-compose.yml в корне монорепо: `docker compose up -d`, эти
# учётные данные — дефолт того контейнера, ничего дополнительно
# настраивать не нужно). На Vercel (см. VERCEL.md) — DATABASE_URL
# обязан быть ПУЛИРОВАННЫМ (Supabase pgbouncer, порт 6543,
# ?pgbouncer=true), иначе serverless-функции быстро упрутся в лимит
# подключений Postgres. DIRECT_URL — только для `prisma migrate`,
# локально можно оставить равным DATABASE_URL.
DATABASE_URL="postgresql://devils_advocate:devils_advocate@localhost:5432/devils_advocate"
DIRECT_URL="postgresql://devils_advocate:devils_advocate@localhost:5432/devils_advocate"

# Токен бота — используется для валидации X-Telegram-Init-Data (Mini App,
# HMAC secret key derivation), для подписи Telegram Login Widget в
# админке и для отправки push-напоминаний планировщика.
# Получить: @BotFather → /mybots → выбрать бота → API Token.
TELEGRAM_BOT_TOKEN=""

# ── Повторный аудит 2026-08-31 ──
# ОПЦИОНАЛЬНО: отдельный бот для входа в админку.
#
# Зачем существует. Домен для Telegram Login Widget привязывается к боту
# через @BotFather /setdomain, и он ОДИН на бота. Если админка живёт на
# своём домене, а Mini App — на другом, удобно завести под вход в
# админку отдельного бота. Но подпись виджета проверяется токеном ИМЕННО
# того бота, чью кнопку нажали, поэтому одного TELEGRAM_BOT_TOKEN в такой
# конфигурации не хватает: один из двух входов будет стабильно отвечать
# «Invalid Telegram Login Widget payload» или «Invalid Telegram initData».
#
# Пусто (обычный случай, один бот на всё) ⇒ используется
# TELEGRAM_BOT_TOKEN, поведение ровно как раньше.
ADMIN_LOGIN_BOT_TOKEN=""

# ⚠️ ТОЛЬКО для local dev/staging. НИКОГДА не выставлять "true" в проде —
# это буквально обход всей аутентификации через заголовок X-Dev-User-Id.
ALLOW_DEV_AUTH="false"

# Чекпоинт 1, пункт 12 — выбор провайдера секретов.
# "env"     — process.env, рабочий вариант прямо сейчас (годится для
#             Vercel encrypted env vars в том числе).
# "managed" — заготовка под выделенный secret manager (Vault/AWS/Doppler),
#             сознательно бросает ошибку до реальной интеграции —
#             см. src/secrets/managed-secret-provider.ts.
SECRET_PROVIDER_TYPE="env"

# Пример: credentialRef для AIProvider (пункт 6) в режиме "env" — имя
# переменной окружения, где реально лежит ключ. Сам ключ НЕ хранится
# в БД (AIProvider.credentialRef = "OPENAI_API_KEY", не сырое значение).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
XAI_API_KEY=""

# Пункт 13 — Conversation Dossier: STT/диаризация (AssemblyAI).
ASSEMBLYAI_API_KEY=""

# Пункт 13 — публичный базовый URL этого API-деплоя, нужен для сборки
# webhook-адреса, на который AssemblyAI пришлёт результат транскрибации
# (см. ConversationsService.buildWebhookUrl()). На Vercel — URL самого
# apps/api проекта; локально — недоступен извне (AssemblyAI не сможет
# достучаться до localhost), транскрибация локально не тестируется
# сквозным вызовом без туннеля (ngrok/аналог).
API_PUBLIC_BASE_URL=""

PORT="3000"

# Домены, которым разрешён CORS (через запятую) — см. create-app.ts.
# Локально можно не задавать (в dev origin: true, разрешено всё — на
# localhost нет реального стороннего сайта, способного этим
# злоупотребить). НА PRODUCTION (NODE_ENV=production) — ОБЯЗАТЕЛЬНО,
# не опционально: без этого CORS для всех cross-origin запросов будет
# заблокирован полностью (fail-closed по дизайну, не fail-open "true").
# Причина ужесточения — Пункт [admin-panel]: как только появился
# credentials: true (нужен для cookie AdminSession), отражение ЛЮБОГО
# Origin стало бы CSRF/утечкой данных для залогиненного оператора —
# найдено и закрыто аудитом, см. apps/api/prisma/README.md.
# Перечислить домены apps/tma, apps/landing И apps/admin — все три
# ходят в этот API cross-origin.
CORS_ORIGIN=""

# Пункт [media-review] (devils-advocate-media-review-tz.md §2.1) —
# YouTube Data API v3 ключ, только search.list/videos.list (только
# метаданные, никакого видео/аудио контента — см. README §2.2).
# Получить: console.cloud.google.com → APIs & Services → Library →
# "YouTube Data API v3" → Enable → Credentials → Create API key.
# Квота — 10 000 единиц/день на проект, search.list стоит 100 единиц
# за вызов (~100 поисков/день максимум на весь проект).
YOUTUBE_API_KEY=""

# Пункт [media-review] (devils-advocate-media-review-tz.md §2.4) —
# Google Fact Check Tools API ключ, только claims:search (структурный
# поиск по тексту утверждения среди уже проведённых фактчеков
# аккредитованных изданий, НЕ произвольный веб-поиск). Получить:
# console.cloud.google.com → APIs & Services → Library →
# "Fact Check Tools API" → Enable → Credentials → Create API key.
# OAuth/Search Console НЕ нужны — это только для ClaimReview markup
# CRUD (публикация своих фактчеков), не для поиска чужих.
FACT_CHECK_TOOLS_API_KEY=""

# ── Добавлено аудитом: пять секретов реально читались сервисами, но
#    отсутствовали в этом файле (в README они упоминались только прозой).

# Пункт 63 — TTS (ElevenLabs). Используется TextToSpeechService: озвучка
# реплик AI-собеседника в спарринге / чате по материалам.
ELEVENLABS_API_KEY=""

# Пункты 50/66 — Google Places (рекомендации заведений для встречи,
# автоопределение заведения в заявке владельца). Только Places API (New).
GOOGLE_PLACES_API_KEY=""

# Google Cloud Vision (OCR документов) — DtpService / HealthService /
# MajorPurchaseService. Только images:annotate, TEXT_DETECTION.
GOOGLE_VISION_API_KEY=""

# Пункт 48 — реверс-поиск фото (§4.4 ТЗ) через SerpApi. Требует, чтобы
# изображение было доступно по публичному URL — см. VERCEL_BLOB_* ниже.
SERPAPI_KEY=""

# Пункт 48 — Vercel Blob для ВРЕМЕННОГО публичного хранения фото на время
# реверс-поиска (удаляется в finally независимо от исхода). Согласие
# PUBLIC_IMAGE_SEARCH запрашивается отдельно.
VERCEL_BLOB_READ_WRITE_TOKEN=""

# ── Повторный аудит 2026-08-30 ──
# Секрет для заголовка x-dispatch-secret на трёх server-to-server
# эндпоинтах, которые в проде дёргает pg_cron: /internal/reminders/dispatch,
# /internal/calibration/recompute, /intake/abandon-stale. Переменная
# реально читается кодом (SecretsService.resolve), но в этом файле её не
# было — упоминалась только прозой в комментарии ниже. Сгенерируйте
# длинную случайную строку: openssl rand -base64 32
SCHEDULER_DISPATCH_SECRET=""

# ТЗ domain-ui-and-voice-intake §2.2 п.7 — POST /intake/abandon-stale
# (сессии квиза без dispatch > 24 ч → ABANDONED). Вызывается pg_cron/pg_net
# раз в сутки с заголовком x-dispatch-secret: тот же SCHEDULER_DISPATCH_SECRET,
# что у scheduler/dispatch — отдельный секрет ради одного задания не заводится
# (то же решение, что в prisma/README.md, Пункт reminders). Отдельной
# переменной нет — см. SCHEDULER_DISPATCH_SECRET выше, если он ещё не
# добавлен в этот файл, добавьте:
# SCHEDULER_DISPATCH_SECRET=""

# ── Полный аудит 2026-08-30 ──
# Секрет, который AssemblyAI возвращает в заголовке x-assemblyai-webhook-secret
# при доставке результата транскрипции (webhook_auth_header_*). Проверяется
# AssemblyAiWebhookGuard на conversations/sparring/material-chat вебхуках.
# Без него transcription submitJob() отказывает (fail closed) — сгенерируйте
# любой длинный случайный: `openssl rand -base64 32`.
ASSEMBLYAI_WEBHOOK_SECRET=""

# ── Расширение периметра погоды 2026-08-30 (по прямому запросу) ──
# Опциональный ПЕРВИЧНЫЙ источник погоды (Windy Point Forecast, модель icon —
# см. windy-client.ts). Требует платной/freemium регистрации на api.windy.com,
# в отличие от Open-Meteo (fallback), который остаётся бесплатным и без ключа.
# Пусто ⇒ используется только Open-Meteo, как раньше — код это учитывает
# и не делает лишних попыток без ключа.
WINDY_API_KEY=""

# ── Пункт [multimodal] (devils-advocate-multimodal-media-analysis-tz.md) ──
# Gemini — мультимодальный анализ: автоматический разбор публичного
# YouTube-видео по URI (байты ролика НИКОГДА не проходят через нашу
# инфраструктуру) и паралингвистика собственных записей.
# https://aistudio.google.com → Get API key. Free tier: 8 часов
# YouTube-видео в сутки НА КЛЮЧ (не на пользователя).
GEMINI_API_KEY=""
# Секрет воркера асинхронной AI-полосы (pg_cron → /internal/ai-jobs/*):
# openssl rand -base64 32; то же значение — в pg_cron_ai_jobs.sql.
AI_JOB_DISPATCH_SECRET=""
