# Чекпоинт 1, пункт 11 — переменные окружения для TMA auth

# Локально — обычное прямое соединение к docker-compose Postgres (см.
# docker-compose.yml в корне монорепо: `docker compose up -d`, эти
# учётные данные — дефолт того контейнера, ничего дополнительно
# настраивать не нужно). На Vercel (см. VERCEL.md) — DATABASE_URL
# обязан быть ПУЛИРОВАННЫМ (Supabase pgbouncer, порт 6543,
# ?pgbouncer=true), иначе serverless-функции быстро упрутся в лимит
# подключений Postgres. DIRECT_URL — только для `prisma migrate`,
# локально можно оставить равным DATABASE_URL.
DATABASE_URL="postgresql://devils_advocate:devils_advocate@localhost:5432/devils_advocate"
DIRECT_URL="postgresql://devils_advocate:devils_advocate@localhost:5432/devils_advocate"

# Токен бота — используется ТОЛЬКО для валидации X-Telegram-Init-Data
# (HMAC secret key derivation), не для отправки сообщений напрямую из
# этого сервиса (если понадобится Bot API — отдельный клиент/ключ).
TELEGRAM_BOT_TOKEN=""

# ⚠️ ТОЛЬКО для local dev/staging. НИКОГДА не выставлять "true" в проде —
# это буквально обход всей аутентификации через заголовок X-Dev-User-Id.
ALLOW_DEV_AUTH="false"

# Чекпоинт 1, пункт 12 — выбор провайдера секретов.
# "env"     — process.env, рабочий вариант прямо сейчас (годится для
#             Vercel encrypted env vars в том числе).
# "managed" — заготовка под выделенный secret manager (Vault/AWS/Doppler),
#             сознательно бросает ошибку до реальной интеграции —
#             см. src/secrets/managed-secret-provider.ts.
SECRET_PROVIDER_TYPE="env"

# Пример: credentialRef для AIProvider (пункт 6) в режиме "env" — имя
# переменной окружения, где реально лежит ключ. Сам ключ НЕ хранится
# в БД (AIProvider.credentialRef = "OPENAI_API_KEY", не сырое значение).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
XAI_API_KEY=""

# Пункт 13 — Conversation Dossier: STT/диаризация (AssemblyAI).
ASSEMBLYAI_API_KEY=""

# Пункт 13 — публичный базовый URL этого API-деплоя, нужен для сборки
# webhook-адреса, на который AssemblyAI пришлёт результат транскрибации
# (см. ConversationsService.buildWebhookUrl()). На Vercel — URL самого
# apps/api проекта; локально — недоступен извне (AssemblyAI не сможет
# достучаться до localhost), транскрибация локально не тестируется
# сквозным вызовом без туннеля (ngrok/аналог).
API_PUBLIC_BASE_URL=""

PORT="3000"

# Домены, которым разрешён CORS (через запятую) — см. create-app.ts.
# Локально можно не задавать (тогда origin: true, разрешено всё).
# На Vercel — обязательно домен задеплоенного проекта apps/tma.
CORS_ORIGIN=""

