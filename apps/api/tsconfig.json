{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "lib": ["ES2021"],
    "types": ["node", "jest"]
  },
  // Спеки намеренно ВНУТРИ тайпчека (аудит 2026-09-01): исключение
  // **/*spec.ts скрывало рассинхрон спек с сигнатурами сервисов —
  // тесты конструировали сервисы устаревшим числом зависимостей и
  // «зеленели», проверяя объект с undefined-полем. Сборка использует
  // отдельный tsconfig.build.json, спеки в dist не попадают.
  // prisma/** и scripts/** тоже добавлены (аудит 2026-09-01): сиды и
  // диагностические скрипты не входили ни в один tsconfig — ни тайпчека,
  // ни линта у них не было вообще, хотя seed.ts исполняется на каждом
  // деплое.
  "include": ["src/**/*", "api/**/*", "prisma/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
