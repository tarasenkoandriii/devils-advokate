# Devil's Advocate — переменные для локального докер-стенда
# (docker-compose.dev.yml, инструкция — DOCKER.md).
#
#   cp .env.docker.example .env.docker
#   make up            # либо: docker compose --env-file .env.docker -f docker-compose.dev.yml up -d --build
#
# ВАЖНО: этот файл подставляется docker compose ЧЕРЕЗ --env-file, а не
# читается приложением напрямую.
#
# Про apps/api/.env, честно: он контейнеру НЕ нужен, но и не невидим —
# папка apps/api монтируется внутрь, а ConfigModule читает .env из неё.
# Переменные из compose имеют приоритет (ConfigModule не перетирает уже
# существующие в process.env), поэтому расхождение возможно ровно для
# тех переменных, которых в compose нет вообще. Чтобы такого класса
# сюрпризов не было, все переменные, которые читает apps/api, заданы в
# docker-compose.dev.yml явно — включая CORS_ORIGIN, заданный пустым.
#
# ═══════════════════════════════════════════════════════════════════
# СТЕНД ПОДНИМАЕТСЯ БЕЗ ЕДИНОГО КЛЮЧА. Пустое значение — не ошибка:
# сервис, которому ключ не задан, честно откажет на своём эндпоинте
# (BadGateway/ServiceUnavailable), а не уронит запуск API. Заполняйте
# только то, что реально собираетесь трогать.
# ═══════════════════════════════════════════════════════════════════

# ── Дев-вход ───────────────────────────────────────────────────────
# Условный id пользователя для дев-входа. Один и тот же в трёх местах:
# заголовок X-Dev-User-Id (TMA), кнопка «Войти как dev-…» (админка),
# сид seed-dev.ts. В БД он превращается в telegramId "dev-123".
DEV_USER_ID=123

# Выдать dev-пользователю согласия (EXTERNAL_AI/RECORDING/EPHEMERAL_SERVER)
# прямо из сида. По умолчанию false — consent-гейты часть продукта, их
# стоит проходить руками хотя бы раз. true — если отлаживаете не их.
SEED_DEV_CONSENTS=false

# ── Telegram ───────────────────────────────────────────────────────
# Нужен ТОЛЬКО для настоящей авторизации (initData/Login Widget). Для
# дев-входа не требуется вообще. Получить: @BotFather → /newbot.
TELEGRAM_BOT_TOKEN=
# Username бота без @ — два назначения: Telegram Login Widget в админке
# и (Пункт [deep-links] 2026-09-02) построение ссылок-приглашений API:
# передача профиля кандидата, инвайт в команду рекрутинга, инвест-группа.
# При дев-входе для админки не нужен; для ссылок-приглашений — нужен либо
# он, либо TELEGRAM_MINI_APP_URL ниже, иначе эти эндпоинты отвечают 503.
TELEGRAM_BOT_USERNAME=
# Прямая ссылка на Mini App (https://t.me/<бот>/<приложение>). Имеет
# приоритет над TELEGRAM_BOT_USERNAME: открывает приложение сразу,
# минуя экран чата с ботом.
TELEGRAM_MINI_APP_URL=
# Опционально: токен ОТДЕЛЬНОГО бота для входа в админку — нужен, только
# если Login Widget выдаёт не тот же бот, что владеет Mini App (домен
# виджета привязывается через /setdomain и он один на бота). Пусто ⇒
# используется TELEGRAM_BOT_TOKEN.
ADMIN_LOGIN_BOT_TOKEN=

# ── LLM-провайдеры (нужен хотя бы один для любой AI-функции) ────────
# platform.openai.com → API keys
OPENAI_API_KEY=
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# console.x.ai → API keys
XAI_API_KEY=

# ── Транскрибация (разбор аудио/видео разговоров) ───────────────────
# assemblyai.com → Dashboard → API key
ASSEMBLYAI_API_KEY=
# Пункт [stt-multi] 2026-09-02 — распознавание русского и украинского
# (у AssemblyAI этих языков нет в потоковом режиме). soniox.com → API keys.
SONIOX_API_KEY=
# Тот же секрет вебхуков распознавания под нейтральным именем (точка
# приёма одна на двух провайдеров). Пусто ⇒ работает
# ASSEMBLYAI_WEBHOOK_SECRET, менять ничего не нужно.
STT_WEBHOOK_SECRET=
# Любая длинная случайная строка: openssl rand -base64 32
ASSEMBLYAI_WEBHOOK_SECRET=
# Публичный адрес, на который AssemblyAI пришлёт результат. На
# localhost он НЕ достучится — нужен туннель (ngrok/cloudflared) и его
# https-адрес здесь. Пусто = транскрибация не запустится (fail closed).
API_PUBLIC_BASE_URL=

# ── Медиа-разбор (YouTube) ─────────────────────────────────────────
# console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=
# console.cloud.google.com → APIs & Services → Fact Check Tools API
FACT_CHECK_TOOLS_API_KEY=

# ── Остальные внешние сервисы (опционально) ────────────────────────
ELEVENLABS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_VISION_API_KEY=
SERPAPI_KEY=
VERCEL_BLOB_READ_WRITE_TOKEN=
WINDY_API_KEY=

# Секрет для эндпоинтов, которые в проде дёргает pg_cron. Локально
# cron'а нет — значение нужно только чтобы вызвать их вручную curl'ом.
SCHEDULER_DISPATCH_SECRET=dev-dispatch-secret

# Ссылка на бота для CTA лендинга (только внешний вид страницы).
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/your_bot_username/app

# Пункт [multimodal]: мультимодальный анализ (Gemini) и воркер
# асинхронной полосы. Локально воркер можно дёргать руками:
#   curl -X POST localhost:3000/internal/ai-jobs/submit -H "x-dispatch-secret: $AI_JOB_DISPATCH_SECRET"
GEMINI_API_KEY=
AI_JOB_DISPATCH_SECRET=dev-dispatch-secret
